// ============================================================
// VULNERABLE DEVICES
// Only PC* devices + only target software
// ============================================================
DeviceTvmSoftwareVulnerabilities
| where isnotempty(DeviceName)
| where DeviceName startswith "PC"
| where SoftwareName in~ (TargetSoftware)
| summarize
    AffectedDevices = dcount(DeviceId)
    by
        CveId,
        VulnerabilitySeverityLevel,
        SoftwareVendor,
        SoftwareName,
        SoftwareVersion
| order by AffectedDevices desc
