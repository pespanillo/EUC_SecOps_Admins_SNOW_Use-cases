# =================================================================================================
# FUNCTION: GET EXACT TARGET REGISTRY ENTRY FROM HKLM64
# =================================================================================================
function Get-TargetRegistryEntry {
    $BaseKey = $null
    $TargetKey = $null

    try {
        $BaseKey = [Microsoft.Win32.RegistryKey]::OpenBaseKey(
            [Microsoft.Win32.RegistryHive]::LocalMachine,
            [Microsoft.Win32.RegistryView]::Registry64
        )
        $TargetKey = $BaseKey.OpenSubKey(
            $TargetRegistrySubKey,
            $false
        )
        if (-not $TargetKey) {
            return $null
        }
        return [PSCustomObject]@{
            RegistryPath =
                $TargetRegistryDisplayPath
            PSChildName =
                $TargetRegistryChildName
            DisplayName =
                $TargetKey.GetValue(
                    "DisplayName",
                    $null
                )
            DisplayVersion =
                $TargetKey.GetValue(
                    "DisplayVersion",
                    $null
                )
            Publisher =
                $TargetKey.GetValue(
                    "Publisher",
                    $null
                )
            InstallLocation =
                $TargetKey.GetValue(
                    "InstallLocation",
                    $null
                )
            UninstallString =
                $TargetKey.GetValue(
                    "UninstallString",
                    $null
                )
            QuietUninstallString =
                $TargetKey.GetValue(
                    "QuietUninstallString",
                    $null
                )
            DisplayIcon =
                $TargetKey.GetValue(
                    "DisplayIcon",
                    $null
                )
        }
    }
    catch {
        Write-Output "ERROR - Unable to query exact HKLM64 target registry entry."
        Write-Output "DETAIL: $($_.Exception.Message)"

        return $null
    }
    finally {

        if ($TargetKey) {
            $TargetKey.Dispose()
        }
        if ($BaseKey) {
            $BaseKey.Dispose()
        }
    }
}
# =================================================================================================
# FUNCTION: RESOLVE REGISTERED UNINSTALL COMMAND
# =================================================================================================
function Resolve-RegisteredCommand {
    param (

        [Parameter(Mandatory = $true)]
        [string]$CommandLine
    )
    $ExpandedCommand =
        [Environment]::ExpandEnvironmentVariables(
            $CommandLine.Trim()
        )
    if (
        [string]::IsNullOrWhiteSpace(
            $ExpandedCommand
        )
    ) {
        return $null
    }

    # ---------------------------------------------------------------------------------------------
    # CASE 1:
    # Quoted executable
    #
    # Example:
    #   "C:\Program Files\Product\unins000.exe" /VERYSILENT
    # ---------------------------------------------------------------------------------------------
    if (
        $ExpandedCommand -match
        '^\s*"([^"]+)"\s*(.*)$'
    ) {
        return [PSCustomObject]@{
            Executable =
                $Matches[1].Trim()
            Arguments =
                $Matches[2].Trim()
        }
    }
    # ---------------------------------------------------------------------------------------------
    # CASE 2:
    # Unquoted executable.
    #
    # Do not split at first space because the path may contain spaces.
    # Evaluate possible .exe boundaries from longest to shortest.
    # ---------------------------------------------------------------------------------------------
    $ExeMatches =
        [regex]::Matches(
            $ExpandedCommand,
            '(?i)\.exe'
        )
    if ($ExeMatches.Count -eq 0) {
        return $null
    }
    for (
        $Index = $ExeMatches.Count - 1
        $Index -ge 0
        $Index--
    ) {
        $EndPosition =
            $ExeMatches[$Index].Index +
            $ExeMatches[$Index].Length
        $CandidateExecutable =
            $ExpandedCommand.Substring(
                0,
                $EndPosition
            ).Trim().Trim('"')
        $CandidateArguments =
            $ExpandedCommand.Substring(
                $EndPosition
            ).Trim()
        if (
            Test-Path `
                -LiteralPath $CandidateExecutable `
                -PathType Leaf
        ) {
            return [PSCustomObject]@{
                Executable =
                    $CandidateExecutable
                Arguments =
                    $CandidateArguments
            }
        }
    }
    return $null
}
# =================================================================================================
# FUNCTION: EXECUTE VERIFIED UNINSTALLER
# =================================================================================================
function Invoke-VerifiedUninstaller {
    param (
        [Parameter(Mandatory = $true)]
        [string]$Executable,
        [AllowEmptyString()]
        [string]$Arguments
    )
    # ---------------------------------------------------------------------------------------------
    # FINAL PRE-EXECUTION CHECK
    # ---------------------------------------------------------------------------------------------
    if (
        -not (
            Test-Path `
                -LiteralPath $Executable `
                -PathType Leaf
        )
    ) {
        Write-Output ""
        Write-Output "FAILED - Verified uninstall executable no longer exists:"
        Write-Output $Executable
        return $null
    }
    Write-Output ""
    Write-Output "UNINSTALL EXECUTION"
    Write-Output "Executable : $Executable"
    if (
        -not [string]::IsNullOrWhiteSpace(
            $Arguments
        )
    ) {
        Write-Output "Arguments  : $Arguments"
    }
    try {
        $Process = $null
        if (
            -not [string]::IsNullOrWhiteSpace(
                $Arguments
            )
        ) {
            $Process =
                Start-Process `
                    -FilePath $Executable `
                    -ArgumentList $Arguments `
                    -Wait `
                    -PassThru `
                    -WindowStyle Hidden `
                    -ErrorAction Stop
        }
        if (
            [string]::IsNullOrWhiteSpace(
                $Arguments
            )
        ) {
            $Process =
                Start-Process `
                    -FilePath $Executable `
                    -Wait `
                    -PassThru `
                    -WindowStyle Hidden `
                    -ErrorAction Stop
        }
        Write-Output "Process completed."
        Write-Output "Exit Code  : $($Process.ExitCode)"
        return $Process.ExitCode
    }
    catch {
        Write-Output ""
        Write-Output "FAILED - Unable to execute verified target uninstaller."
        Write-Output "DETAIL: $($_.Exception.Message)"
        return $null
    }
}
