#    - No broad publisher or product keyword matching.
#
# 4. FAIL-CLOSED WHEN EXACT TARGET KEY EXISTS
#    - If the exact target registry key exists, the device remains Non-Compliant.
#    - Missing or unexpected DisplayName metadata does NOT convert the machine to Compliant.
#    - Unexpected metadata is reported for investigation.
#
# 5. NO GUESSED FILESYSTEM PATHS
#    - ControlUp did not provide an exact filesystem path.
#    - Therefore Program Files, AppData, ProgramData, Temp, and other locations are not searched.
#
# 6. NO "_is1" GENERIC MATCHING
#    - "_is1" alone is not treated as product evidence.
#    - Only the exact confirmed target key is checked.
#
# 7. REMEDIATION ALIGNMENT
#    - The uninstall script remediates the same exact registry-registered target.
#    - Detection and remediation therefore use the same primary target evidence.
#
# 8. NO FINAL ELSE BLOCK
#    - Detected evidence -> Exit 1
#    - No evidence       -> Exit 0
#
# =================================================================================================

# =================================================================================================
# TARGET CONFIGURATION
# =================================================================================================
$TargetComponent = "Path Copy Copy 19"
$AllowedDisplayNames = @(
    "Path Copy Copy 19",
    "Path Copy Copy 19.0"
)
$TargetRegistryChildName =
    "{3C01F274-867C-4D1D-BE8C-CB488C31B0C9}_is1"
$TargetRegistrySubKey =
    "SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\$TargetRegistryChildName"
$TargetRegistryDisplayPath =
    "HKLM64\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\$TargetRegistryChildName"
# =================================================================================================
# READ EXACT HKLM64 TARGET REGISTRY ENTRY
# =================================================================================================
$BaseKey = $null
$TargetKey = $null
$TargetExists = $false
$DisplayName = $null
$DisplayVersion = $null
$Publisher = $null
$InstallLocation = $null
try {
    $BaseKey = [Microsoft.Win32.RegistryKey]::OpenBaseKey(
        [Microsoft.Win32.RegistryHive]::LocalMachine,
        [Microsoft.Win32.RegistryView]::Registry64
    )
    $TargetKey = $BaseKey.OpenSubKey(
        $TargetRegistrySubKey,
        $false
    )
    if ($TargetKey) {
        $TargetExists = $true
        $DisplayName =
            $TargetKey.GetValue(
                "DisplayName",
                $null
            )
        $DisplayVersion =
            $TargetKey.GetValue(
                "DisplayVersion",
                $null
            )
        $Publisher =
            $TargetKey.GetValue(
                "Publisher",
                $null
            )
        $InstallLocation =
            $TargetKey.GetValue(
                "InstallLocation",
                $null
            )
    }
}
catch {
    Write-Output "NON-COMPLIANT - Unable to safely evaluate Path Copy Copy 19 target evidence."
    Write-Output "ERROR: $($_.Exception.Message)"
    exit 1
}
finally {
    if ($TargetKey) {
        $TargetKey.Dispose()
    }
    if ($BaseKey) {
        $BaseKey.Dispose()
    }
}
# =================================================================================================
# EXACT TARGET REGISTRY KEY EXISTS
# =================================================================================================
if ($TargetExists) {
    Write-Output "NON-COMPLIANT - Path Copy Copy 19 detected."
    Write-Output "FOUND: $TargetRegistryDisplayPath"
    # ---------------------------------------------------------------------------------------------
    # DisplayName metadata
    # ---------------------------------------------------------------------------------------------
    if (
        -not [string]::IsNullOrWhiteSpace(
            $DisplayName
        )
    ) {
        Write-Output "DisplayName: $DisplayName"
    }
    if (
        -not [string]::IsNullOrWhiteSpace(
            $DisplayVersion
        )
    ) {
        Write-Output "DisplayVersion: $DisplayVersion"
    }
    if (
        -not [string]::IsNullOrWhiteSpace(
            $Publisher
        )
    ) {
        Write-Output "Publisher: $Publisher"
    }
    if (
        -not [string]::IsNullOrWhiteSpace(
            $InstallLocation
        )
    ) {
        Write-Output "InstallLocation: $InstallLocation"
    }
    # ---------------------------------------------------------------------------------------------
    # Validate approved target identity.
    #
    # IMPORTANT:
    # Even when DisplayName is missing or unexpected, the exact supplied target
    # registry key still exists and therefore remains a Non-Compliant finding.
    #
    # The metadata condition is reported but does not downgrade the device to compliant.
    # ---------------------------------------------------------------------------------------------
    if (
        [string]::IsNullOrWhiteSpace(
            $DisplayName
        )
    ) {
        Write-Output "WARNING: DisplayName is missing from the exact target registry entry."
        Write-Output "Status: Exact target registry evidence remains."
        exit 1
    }
    $ActualDisplayName =
        $DisplayName.Trim()
    if (
        $AllowedDisplayNames -cnotcontains
        $ActualDisplayName
    ) {
        Write-Output "WARNING: Unexpected DisplayName found in the exact target registry entry."
        Write-Output "Actual DisplayName: $ActualDisplayName"
        Write-Output "Status: Exact target registry evidence remains."
        exit 1
    }
    Write-Output "Status: CONFIRMED TARGET REGISTRATION"
    exit 1
}
# =================================================================================================
# TARGET NOT DETECTED
# =================================================================================================
Write-Output "COMPLIANT - Path Copy Copy 19 not detected."
Write-Output "NOT FOUND: $TargetRegistryDisplayPath"
exit 0




