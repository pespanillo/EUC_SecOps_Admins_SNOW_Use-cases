
DeviceProcessEvents
| where Timestamp >= ago(30d)
| where DeviceName startswith "pc"
| where InitiatingProcessFileName =~ "itunes.exe"
| where FileName in~ (
    "AppleMobileSync.exe",
    "AppleMobileDeviceHelper.exe"
)
| project
    Timestamp,
    DeviceName,
    DeviceId,
    ActionType,
    // ============================================================
    // CHILD PROCESS
    // ============================================================
    ChildFileName = FileName,
    ChildPath = FolderPath,
    ChildCommandLine = ProcessCommandLine,
    ChildProcessId = ProcessId,
    ChildSHA256 = SHA256,
    // ============================================================
    // DIRECT PARENT PROCESS
    // Process that launched the child
    // ============================================================
    ParentFileName = InitiatingProcessFileName,
    ParentPath = InitiatingProcessFolderPath,
    ParentCommandLine = InitiatingProcessCommandLine,
    ParentProcessId = InitiatingProcessId,
    ParentSHA256 = InitiatingProcessSHA256,
    // ============================================================
    // GRANDPARENT
    // Parent of the initiating process
    // ============================================================
    GrandParentFileName = InitiatingProcessParentFileName,
    GrandParentProcessId = InitiatingProcessParentId,
    // ============================================================
    // USER CONTEXT
    // ============================================================
    ChildAccount = strcat(AccountDomain, "\\", AccountName),
    ParentAccount = strcat(
        InitiatingProcessAccountDomain,
        "\\",
        InitiatingProcessAccountName
    )
| project
    Timestamp,
    DeviceName,
    DeviceId,
    //ParentAccount,
    //ChildAccount,
    //ActionType,
    //GrandParentFileName,
    ParentFileName,
    ParentPath,
    //ParentCommandLine,
    //ParentSHA256,
    ChildFileName,
    ChildPath
    //ChildCommandLine,
    //ChildSHA256
| order by DeviceName asc, Timestamp desc








/
DeviceProcessEvents
| where Timestamp >= ago(30d)
| where FileName =~ "iTunes.exe"
| where FolderPath =~ @"C:\Program Files\iTunes"
| project
    Timestamp,
    DeviceName,
    DeviceId,
    FileName,
    FolderPath,
    ProcessCommandLine,
    SHA256
| order by Timestamp desc






DeviceTvmSoftwareInventory
| where SoftwareName contains "itunes"
    or SoftwareName contains "apple"
    or SoftwareVendor contains "apple"
| project
    DeviceName,
    SoftwareVendor,
    SoftwareName,
    SoftwareVersion
| order by SoftwareName asc, DeviceName asc
