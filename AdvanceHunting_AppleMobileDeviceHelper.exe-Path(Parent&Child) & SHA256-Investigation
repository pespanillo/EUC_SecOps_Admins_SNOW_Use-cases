//AdvanceHunting_AppleMobileDeviceHelper.exe-Path(Parent&Child) & SHA256-Investigation
DeviceProcessEvents
| where Timestamp >= ago(30d)
// STRICT TARGET FILE
| where FileName =~ "AppleMobileDeviceHelper.exe"
// STRICT PARENT PROCESS
| where InitiatingProcessFileName =~ "itunes.exe"
// WORKSTATION SCOPE
| where DeviceName startswith "pc"
| project
    Timestamp,
    DeviceName,
    DeviceId,
    ActionType,
    // =========================================================
    // TARGET FILE - AppleMobileDeviceHelper.exe
    // =========================================================
    TargetFileName = FileName,
    TargetFolderPath = FolderPath,
    TargetSHA256 = SHA256,
    TargetSHA1 = SHA1,
    TargetCommandLine = ProcessCommandLine,
    TargetProcessId = ProcessId,
    // =========================================================
    // PARENT PROCESS - iTunes.exe
    // =========================================================
    ParentFileName = InitiatingProcessFileName,
    ParentFolderPath = InitiatingProcessFolderPath,
    ParentSHA256 = InitiatingProcessSHA256,
    ParentSHA1 = InitiatingProcessSHA1,
    ParentCommandLine = InitiatingProcessCommandLine,
    ParentProcessId = InitiatingProcessId,
    // =========================================================
    // GRANDPARENT PROCESS
    // =========================================================
    GrandParentFileName = InitiatingProcessParentFileName,
    GrandParentProcessId = InitiatingProcessParentId,
    // =========================================================
    // USER CONTEXT
    // =========================================================
    AccountDomain,
    AccountName,
    InitiatingProcessAccountDomain,
    InitiatingProcessAccountName
| order by DeviceName asc, Timestamp desc
